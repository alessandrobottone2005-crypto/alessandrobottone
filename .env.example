# variabili delle dediche (api/dediche.ts): si inseriscono su vercel → settings → environment variables.
# guida passo passo: docs/dediche-google-drive.md. in locale (npm run dev) non servono: le dediche restano in memoria.
# mai scrivere i valori veri in questo file né su github.

# cartella di google drive dove finiscono i disegni (l’ultima parte dell’indirizzo della cartella)
DRIVE_CARTELLA_ID=

# opzione a — account di servizio + drive condiviso (google workspace)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# opzione b — account gmail personale: token dell’utente (se presenti, hanno la precedenza sull’opzione a)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
