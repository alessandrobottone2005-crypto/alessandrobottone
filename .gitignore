# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# chiavi e segreti: mai su github
.env
.env.*
!.env.example

# file nascosti che macos crea sui dischi esterni
._*

# impostazioni locali (chiavi e preferenze personali, non vanno su github)
.mcp.json
.claude/settings.local.json
.claude/*.lock
.vercel

# cache rigenerabili e copie di sicurezza Blender (restano sul computer)
sorgenti/logo-3d/anteprime/frames/
# sala: cottura della luce e glb intermedia (si rigenerano con prepara_sala.py, centinaia di MB)
sorgenti/sala/export/*.exr
sorgenti/sala/export/Sala_Web.glb
sorgenti/sala/textures/
*.blend[0-9]*

# bytecode degli script Python
__pycache__/
*.py[cod]

# cache locali degli strumenti di revisione
.impeccable/

# pdf originali dei progetti (decine o centinaia di MB: github rifiuta i file sopra 100 MB). restano sul disco;
# nel sito c’è la versione compressa con npm run comprimi-pdf
sorgenti/progetti/*
!sorgenti/progetti/README.md
# modelli 3d prima della compressione (decine di MB): restano sul disco, nel sito c’è la versione compressa
src/content/progetti/*/_originali/*.glb

# screenshot dei test e audio originali (restano sul computer)
verifiche/risultati/
sorgenti/computer/export/
sorgenti/audio/*.mp3
sorgenti/audio/*.wav
.claude/worktrees/
